PORT=3333
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/RAILWAY
# PGSSLMODE=require
# DATA_FILE e usado somente como fallback local quando DATABASE_URL nao existir.
DATA_FILE=./data/condo-access-state.json
PUBLIC_HOST=192.168.3.27
SIP_DOMAIN=granportalresidency.ddns.net
ASTERISK_PUBLIC_HOST=granportalresidency.ddns.net
ASTERISK_WS_URL=wss://granportalresidency.ddns.net:8089/ws
SIP_DEFAULT_PASSWORD=CondoAccess@2026
FFMPEG_PATH=C:\Program Files\ffmpeg\bin\ffmpeg.exe
EXPOSE_CAMERA_RTSP=false
MOBILE_CAMERA_STREAMS_FILE=C:\projetis\BKPAccess\condo-access-mobile-novo\src\cameras\mobileCameraStreams.ts

# Pagamentos Asaas. Use sandbox ate concluir a homologacao.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Railway trustworthy-nourishment
# PORT e RAILWAY_PUBLIC_DOMAIN sao injetados pelo Railway.
# Conecte o Postgres do Railway ao servico da API para injetar DATABASE_URL.
# A API cria automaticamente a tabela condo_access_state.
# Se DATABASE_URL existir, DATA_FILE nao e usado.
# Em nuvem, deixe MOBILE_CAMERA_STREAMS_FILE vazio ou nao definido.

# Supabase Postgres
# Localize no Supabase em Project Settings > Database > Connection string.
# Para esta API persistente, prefira Session pooler:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
# PGSSLMODE=require
# A API cria automaticamente a tabela condo_access_state no primeiro start.

# Netlify Web
VITE_API_URL=https://api-production-441f.up.railway.app

# Mobile APK/EAS
EXPO_PUBLIC_API_URL=https://api-production-441f.up.railway.app/api
EXPO_PUBLIC_GATEWAY_URL=https://api-production-441f.up.railway.app
EXPO_PUBLIC_STREAM_URL=https://api-production-441f.up.railway.app
EXPO_PUBLIC_WEB_URL=https://exquisite-druid-3a77be.netlify.app
EXPO_PUBLIC_ENABLE_NATIVE_RTSP=false
EXPO_PUBLIC_SIP_DOMAIN=granportalresidency.ddns.net
EXPO_PUBLIC_SIP_WEBSOCKET_URL=wss://granportalresidency.ddns.net:8089/ws
EXPO_PUBLIC_SIP_DEFAULT_PASSWORD=CondoAccess@2026
