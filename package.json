{
  "name": "condo-access-clean",
  "version": "0.1.0",
  "private": true,
  "description": "Base limpa Condo Access separando API, Web e Mobile para interfonia por unidade.",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev:api": "npm --workspace @condo-clean/api run dev",
    "dev:web": "npm --workspace @condo-clean/web run dev",
    "build": "npm --workspaces run build"
  },
  "engines": {
    "node": ">=20"
  }
}
